---
import '../styles/global.css';

import { LOCALE_TAGS } from '../i18n/config';
import { getLocale, useTranslations } from '../i18n/utils';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import MobileActionBar from '../components/MobileActionBar.astro';
import SEO from '../components/SEO.astro';

/**
 * The page shell. Every page in src/pages uses this and nothing else, so the
 * <head>, the header, the footer and the skip link are defined exactly once.
 *
 * The locale is read from the URL rather than passed in as a prop: it is
 * already encoded in the path (Swedish at "/", English under "/en/"), and
 * deriving it means a page cannot declare a language its own URL contradicts.
 */
interface Props {
  title: string;
  description: string;
  /** Share image inside /public. Defaults to the site-wide one. */
  image?: string;
  noindex?: boolean;
  /** Extra class on <main>. */
  mainClass?: string;
}

const { title, description, image, noindex = false, mainClass = '' } = Astro.props;

const locale = getLocale(Astro.url);

// Files served straight out of /public are not rewritten by Astro, so a
// root-absolute href would 404 wherever the site is hosted under a sub-path.
// BASE_URL is '/' normally and '/<repo>/' on GitHub Pages.
const base = import.meta.env.BASE_URL;
const t = useTranslations(locale);
---

<!doctype html>
<html lang={LOCALE_TAGS[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    {
      /*
      Favicons are the company mascot cropped to its triangle badge. The full
      lockup includes an outstretched arm that forces the mark down to an
      unreadable smudge at 16px, so the tab gets the badge and the header gets
      the whole thing — which is what the .ico's 16/32/48 entries are for.
    */
    }
    <link rel="icon" href={`${base}favicon.ico`} sizes="32x32" />
    <link rel="icon" href={`${base}icon.png`} type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    <meta name="theme-color" content="#fbfaf8" />

    {
      /*
      Marks the document as scripted before anything paints, which is what
      arms the scroll-reveal styles. With scripting off the class never
      lands and every section is simply visible — content must never depend
      on JavaScript to appear.
    */
    }
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <SEO title={title} description={description} locale={locale} image={image} noindex={noindex} />

    <slot name="head" />
  </head>

  <body>
    {
      /*
      First focusable element on the page. Invisible until tabbed to, then it
      jumps past the navigation straight to the content.
    */
    }
    <a href="#main" class="sr-only-focusable">{t('nav.skipToContent')}</a>

    <Header locale={locale} />

    <main id="main" class={mainClass}>
      <slot />
    </main>

    <Footer locale={locale} />

    <MobileActionBar locale={locale} />

    <script>
      /**
       * Scroll reveal — one observer for the page, one-shot per element.
       * The movement itself is tiny by design (14px and a fade); the point is
       * that content settles, not that it performs.
       */
      const targets = document.querySelectorAll<HTMLElement>('.reveal');

      if (!('IntersectionObserver' in window)) {
        targets.forEach((element) => element.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );

        targets.forEach((element) => observer.observe(element));
      }
    </script>
  </body>
</html>
