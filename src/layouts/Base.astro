---
import '../styles/global.css';

import { LOCALE_TAGS } from '../i18n/config';
import { getLocale, useTranslations } from '../i18n/utils';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import MobileActionBar from '../components/MobileActionBar.astro';
import SEO from '../components/SEO.astro';

/**
 * The page shell. Every page in src/pages uses this and nothing else, so the
 * <head>, the header, the footer and the skip link are defined exactly once.
 *
 * The locale is read from the URL rather than passed in as a prop: it is
 * already encoded in the path (Swedish at "/", English under "/en/"), and
 * deriving it means a page cannot declare a language its own URL contradicts.
 */
interface Props {
  title: string;
  description: string;
  /** Share image inside /public. Defaults to the site-wide one. */
  image?: string;
  noindex?: boolean;
  /** Extra class on <main>. */
  mainClass?: string;
}

const { title, description, image, noindex = false, mainClass = '' } = Astro.props;

const locale = getLocale(Astro.url);

// Files served straight out of /public are not rewritten by Astro, so a
// root-absolute href would 404 wherever the site is hosted under a sub-path.
// BASE_URL is '/' normally and '/<repo>/' on GitHub Pages.
const base = import.meta.env.BASE_URL;
const t = useTranslations(locale);
---

<!doctype html>
<html lang={LOCALE_TAGS[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    {
      /*
      Favicons are the company mascot cropped to its triangle badge. The full
      lockup includes an outstretched arm that forces the mark down to an
      unreadable smudge at 16px, so the tab gets the badge and the header gets
      the whole thing — which is what the .ico's 16/32/48 entries are for.
    */
    }
    <link rel="icon" href={`${base}favicon.ico`} sizes="32x32" />
    <link rel="icon" href={`${base}icon.png`} type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    <meta name="theme-color" content="#fbfaf8" />

    {
      /*
      Marks the document as scripted before anything paints, which is what
      arms the scroll-reveal styles. With scripting off the class never
      lands and every section is simply visible — content must never depend
      on JavaScript to appear.
    */
    }
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <SEO title={title} description={description} locale={locale} image={image} noindex={noindex} />

    <slot name="head" />
  </head>

  <body>
    {
      /*
      First focusable element on the page. Invisible until tabbed to, then it
      jumps past the navigation straight to the content.
    */
    }
    <a href="#main" class="sr-only-focusable">{t('nav.skipToContent')}</a>

    {
      /*
      Both of these are decoration with no content in them, so they are hidden
      from assistive technology outright. The progress hairline duplicates the
      scrollbar; the curtain is a colour that covers a navigation.
    */
    }
    <div class="scroll-progress" aria-hidden="true"><span></span></div>

    <Header locale={locale} />

    <main id="main" class={mainClass}>
      <slot />
    </main>

    <Footer locale={locale} />

    <MobileActionBar locale={locale} />

    <div class="curtain" data-curtain aria-hidden="true">
      <span class="curtain-line"></span>
    </div>

    <script>
      /**
       * Scroll reveal — one observer for the page, one-shot per element.
       * The movement itself is tiny by design (14px and a fade); the point is
       * that content settles, not that it performs.
       */
      const targets = document.querySelectorAll<HTMLElement>('.reveal');

      if (!('IntersectionObserver' in window)) {
        targets.forEach((element) => element.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );

        targets.forEach((element) => observer.observe(element));
      }
    </script>

    <script>
      /**
       * Arrival, scroll progress, and the curtain over a page change.
       *
       * All three are decoration over content that is already in the HTML, so
       * every one of them is allowed to simply not happen.
       */
      const root = document.documentElement;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      /* The entrance animation is pure CSS — see `.enter` in global.css. It
       * used to be released by a class added here, which made the first
       * screen depend on this bundle loading. It no longer does. */

      /* --- Scroll progress -------------------------------------------------
       * Writes one custom property; the bar itself is scaled on the
       * compositor. Reads are coalesced into a frame so a fast wheel cannot
       * force a layout on every event. */
      const progress = document.querySelector<HTMLElement>('.scroll-progress');

      if (progress) {
        let ticking = false;

        const sync = () => {
          ticking = false;
          const scrollable = document.documentElement.scrollHeight - window.innerHeight;
          const ratio = scrollable > 0 ? window.scrollY / scrollable : 0;
          progress.style.setProperty('--scroll-progress', String(Math.min(1, Math.max(0, ratio))));
        };

        const request = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(sync);
        };

        window.addEventListener('scroll', request, { passive: true });
        window.addEventListener('resize', request, { passive: true });
        sync();
      }

      /* --- The curtain -----------------------------------------------------
       * This site is a multi-page app: a link click hands the browser a new
       * document, and there is a gap before it paints. The curtain covers that
       * gap. It is never dismissed, because the document it lives in is
       * destroyed the moment the next one arrives.
       *
       * Which means the one thing that can go wrong is a navigation that does
       * NOT happen — a cancelled load, or a back-button restore from the
       * bfcache, either of which would leave a live page under a navy sheet.
       * Hence both the timeout and the pageshow handler below.
       */
      const curtain = document.querySelector('[data-curtain]');

      const clearCurtain = () => root.classList.remove('is-leaving');

      // Restoring from the bfcache re-shows this exact document, curtain and
      // all, so it has to be lifted on the way back in.
      window.addEventListener('pageshow', clearCurtain);
      window.addEventListener('popstate', clearCurtain);

      if (curtain && !reduceMotion.matches) {
        document.addEventListener('click', (event) => {
          if (event.defaultPrevented || event.button !== 0) return;
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

          const link = (event.target as Element | null)?.closest?.('a');
          if (!(link instanceof HTMLAnchorElement)) return;

          // Anything that is not this site opening in this tab is left alone:
          // downloads, new tabs, tel: and mailto:, and opt-outs.
          if (link.hasAttribute('download') || link.hasAttribute('data-no-curtain')) return;
          if (link.target && link.target !== '_self') return;
          if (link.origin !== window.location.origin) return;

          // A jump inside the current page is not a navigation.
          const samePage =
            link.pathname === window.location.pathname && link.search === window.location.search;
          if (samePage) return;

          root.classList.add('is-leaving');

          // If the load is cancelled or stalls, give the page back rather than
          // leaving someone staring at a blank colour.
          window.setTimeout(clearCurtain, 4000);
        });
      }
    </script>
  </body>
</html>
