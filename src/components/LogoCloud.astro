---
import { hasLogos, logos, shouldScroll } from '../data/logos';
import { pick, useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/config';

/**
 * A slow marquee of partner / certification logos with faded edges.
 *
 * Modelled on the @efferd/logo-cloud-3 / -4 blocks, rebuilt natively. Those two
 * blocks are the same marquee with different defaults, and both are React
 * components that pull framer-motion in through @efferd/infinite-slider.
 * This site is plain Astro that currently ships zero JavaScript — installing
 * either would have meant adding React, a renderer and a motion library to the
 * bundle for one decorative strip.
 *
 * Everything they do visually is CSS here: the rail is the list repeated a few
 * times and slid left by exactly one copy's width, which loops seamlessly
 * because each copy lands where the one before it began. The edge fade is a
 * mask rather than the original's gradient overlays, so it works on any
 * background.
 *
 * Every copy after the first is aria-hidden and unlinked — a screen reader
 * should hear each partner once, and Tab should stop on each link once.
 *
 * Renders nothing at all while src/data/logos.ts is empty. A logo cloud with
 * no logos is a hole in the page, and a logo cloud with logos the company has
 * no relationship with is worse than a hole.
 *
 * Below MARQUEE_MIN logos it does not scroll at all — see the note in
 * src/data/logos.ts. One wordmark drifting across an empty band reads as a
 * broken carousel, so the row simply centres and stays put. The duplicate
 * track is dropped with it, since there is nothing to loop.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

/**
 * How many times the row is repeated on the rail.
 *
 * The animation slides every copy left by exactly one copy's width, so copy 2
 * lands where copy 1 started. That only reads as seamless while the copies
 * *behind* the last one still cover the column — and two copies of four logos
 * are narrower than 76rem, so a bare gap sweeps through on every loop. Repeat
 * until roughly this many wordmarks are on the rail and it stays wider than
 * the column at any viewport.
 */
const RAIL_MIN_LOGOS = 12;
const trackCount = shouldScroll ? Math.ceil(RAIL_MIN_LOGOS / logos.length) + 1 : 1;
---

{
  hasLogos && (
    <section class="lc" aria-label={t('home.logos.title')}>
      {/* Held to the same column as every other band on the site, so the strip
          centres on the page grid instead of bleeding to the viewport edges.
          The mask then fades at the column edge, not at the screen edge. */}
      <div class="container-page">
        <p class="lc-title">{t('home.logos.title')}</p>

        <div class={`lc-viewport${shouldScroll ? '' : ' lc-viewport--still'}`}>
          {/* Copies after the first are there only to keep the rail longer
              than the column, so they carry empty alt text and no links. When
              the row is too short to scroll, trackCount is 1 and this renders
              the list exactly once. */}
          {Array.from({ length: trackCount }, (_, copy) => (
            <ul class="lc-track" aria-hidden={copy > 0 ? 'true' : undefined}>
              {logos.map((logo) => (
                <li>
                  {copy === 0 && logo.href ? (
                    <a href={logo.href} rel="noopener noreferrer" target="_blank">
                      <img
                        src={logo.src}
                        alt={pick(logo.alt, locale)}
                        loading="lazy"
                        decoding="async"
                      />
                    </a>
                  ) : (
                    <img
                      src={logo.src}
                      alt={copy === 0 ? pick(logo.alt, locale) : ''}
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .lc {
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  .lc-title {
    text-align: center;
    font-size: 0.9375rem;
    color: var(--ink-faint);
    margin-bottom: 1.75rem;
  }

  .lc-viewport {
    display: flex;
    overflow: hidden;
    /* Fades both edges. A mask rather than gradient overlays, so it does not
       need to know what colour is behind it. */
    mask-image: linear-gradient(to right, transparent, #000 12%, #000 88%, transparent);
  }

  .lc-track {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: clamp(2.5rem, 5vw, 4rem);
    padding-inline: clamp(1.25rem, 2.5vw, 2rem);
    list-style: none;
    margin: 0;
    animation: lc-scroll 42s linear infinite;
  }

  .lc-viewport:hover .lc-track {
    animation-play-state: paused;
  }

  /* Too few to loop: no movement, no edge fade to hide an entrance that never
     happens, and the row centred in the band instead of running off it. */
  .lc-viewport--still {
    justify-content: center;
    mask-image: none;
  }

  .lc-viewport--still .lc-track {
    animation: none;
  }

  .lc-track img {
    height: clamp(1.5rem, 2.4vw, 2rem);
    width: auto;
    object-fit: contain;
    /* Logos arrive in every colour there is. Muting them to one tone stops the
       strip becoming the loudest thing on a deliberately quiet page. */
    filter: grayscale(1);
    opacity: 0.55;
    transition:
      filter var(--dur) var(--ease),
      opacity var(--dur) var(--ease);
  }

  .lc-track a:hover img {
    filter: none;
    opacity: 1;
  }

  @keyframes lc-scroll {
    to {
      /* Exactly one track's width, including the gap that follows it. */
      transform: translateX(calc(-100% - clamp(2.5rem, 5vw, 4rem)));
    }
  }

  /* Endless movement is a common migraine and vestibular trigger, so the
     marquee stops completely and the row simply sits there. */
  @media (prefers-reduced-motion: reduce) {
    .lc-track {
      animation: none;
    }

    .lc-viewport {
      overflow-x: auto;
    }
  }
</style>
