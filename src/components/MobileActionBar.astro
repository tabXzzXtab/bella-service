---
import { site } from '../data/site';
import { path, useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/config';

/**
 * Floating call/quote bar, phones only.
 *
 * For this trade the phone converts harder than any form: someone who has just
 * noticed moss on the roof wants to talk to a person. So the number stays
 * within thumb reach.
 *
 * It floats as a rounded bar with a margin rather than a full-width slab
 * welded to the bottom edge — the slab version covers content and looks like
 * a cookie banner. Hidden from 48rem up, where the header action is always
 * visible anyway.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<div class="bar">
  <a href={`tel:${site.phone.href}`} class="bar-action">{t('common.call')}</a>
  <a href={path('contact', locale)} class="bar-action bar-action--accent">
    {t('common.bookInspection')}
  </a>
</div>

<style>
  .bar {
    position: fixed;
    inset-inline: 0.75rem;
    bottom: calc(0.75rem + env(safe-area-inset-bottom, 0px));
    z-index: 60;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.4rem;
    padding: 0.4rem;
    background-color: rgb(255 255 255 / 0.82);
    backdrop-filter: blur(14px) saturate(150%);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow);
  }

  @media (width >= 48rem) {
    .bar {
      display: none;
    }
  }

  .bar-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.7rem 1.1rem;
    border-radius: var(--radius-pill);
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-decoration: none;
    color: var(--ink);
    white-space: nowrap;
  }

  .bar-action--accent {
    background-color: var(--ink);
    color: var(--bg);
  }
</style>
