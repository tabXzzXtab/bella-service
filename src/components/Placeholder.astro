---
import { ASPECT_CSS, media, type MediaId } from '../data/media';
import { pick } from '../i18n/utils';
import type { Locale } from '../i18n/config';

/**
 * An image slot that works before the image exists.
 *
 * The client has no photography yet, so every image slot is registered in
 * src/data/media.ts with the aspect ratio it will occupy. This reserves
 * exactly that space now, so dropping the real photograph in later cannot
 * shift a single pixel.
 *
 * The stand-in is a soft tinted block, not a dashed outline with a label in
 * the middle. A dashed box reads as broken; a quiet tinted panel reads as
 * a photograph that has not loaded yet, which is much closer to the truth
 * and much less distracting when there are eight of them on a page.
 *
 * A slot carrying `video` renders a silent looping clip with the still as its
 * poster, so the space it occupies is identical either way.
 */
interface Props {
  id: MediaId;
  locale: Locale;
  class?: string;
  /** Load eagerly. Set this on the hero image only. */
  priority?: boolean;
  /** Corner radius. `none` for images that sit flush in a band. */
  radius?: 'default' | 'lg' | 'none';
}

const { id, locale, class: className = '', priority = false, radius = 'default' } = Astro.props;

const slot = media[id];
const alt = pick(slot.alt, locale);

/* `media` is `as const`, so each slot narrows to its own literal shape and the
   ones with no clip have no `video` property at all to read. `in` narrows the
   union instead of widening the manifest. */
const videoSrc = 'video' in slot ? slot.video : undefined;

const radiusValue =
  radius === 'none' ? '0' : radius === 'lg' ? 'var(--radius-lg)' : 'var(--radius)';
---

<figure
  class={`media ${className}`}
  style={`--media-aspect:${ASPECT_CSS[slot.aspect]};--media-radius:${radiusValue}`}
>
  {
    videoSrc ? (
      <video
        src={videoSrc}
        poster={slot.src ?? undefined}
        aria-label={alt}
        data-reduce-motion-pause
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
      />
    ) : slot.src ? (
      <img
        src={slot.src}
        alt={alt}
        loading={priority ? 'eager' : 'lazy'}
        decoding={priority ? 'sync' : 'async'}
        fetchpriority={priority ? 'high' : undefined}
      />
    ) : (
      <div class="media-stand-in" role="img" aria-label={alt} />
    )
  }
</figure>

{
  /*
  A looping clip is motion nobody asked for, and CSS cannot stop a video the
  way it stops an animation — so this is the one thing on the page that needs
  a line of script to honour `prefers-reduced-motion`.

  `is:inline` keeps it out of the bundler: it ships as ~200 bytes of markup
  rather than as a JavaScript asset, so the site still requests no .js file.

  Only a slot that actually carries a clip emits it, so the pages with no video
  carry none of it, and the guard covers the pages that have more than one.
  */
}{
  videoSrc && (
    <script
      is:inline
      set:html={`if (!window.__bsMotion) {
  window.__bsMotion = 1;
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    addEventListener('DOMContentLoaded', function () {
      document.querySelectorAll('video[data-reduce-motion-pause]').forEach(function (v) {
        v.autoplay = false;
        v.loop = false;
        v.controls = true;
        v.pause();
      });
    });
  }
}`}
    />
  )
}

<style>
  .media {
    margin: 0;
    aspect-ratio: var(--media-aspect);
    overflow: hidden;
    border-radius: var(--media-radius);
    background-color: var(--bg-sunk);
  }

  .media :global(img),
  .media :global(video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Which part of the frame survives the crop. A parent that forces the slot
       into a different shape than the file — a full-bleed band, say — sets this
       to say what must not be cut off. */
    object-position: var(--media-focus, 50% 50%);
    display: block;
  }

  /* A barely-there diagonal, so the block reads as a deliberate placeholder
     rather than as a broken image — without ever asking for attention. */
  .media-stand-in {
    width: 100%;
    height: 100%;
    background-image: repeating-linear-gradient(
      -45deg,
      rgb(22 25 31 / 0.028) 0 10px,
      transparent 10px 20px
    );
  }
</style>
