---
import Placeholder from './Placeholder.astro';
import type { MediaId } from '../data/media';
import type { Locale } from '../i18n/config';

/**
 * A photograph or clip that runs the full width of the screen, with an
 * optional line of text set into one corner.
 *
 * It is a direct child of its section, not of `.container-page` — the point of
 * the band is that it breaks the page grid, and wrapping it in the column made
 * it just another picture with margins.
 *
 * On a wide screen it is height-capped rather than aspect-locked, so the whole
 * band fits on one screen instead of running past the fold; `object-fit: cover`
 * inside `<Placeholder>` does the cropping. On a phone the cap is dropped and
 * the media keeps its natural ratio, because 80vh of a portrait screen would
 * crop a landscape frame down to a letterbox.
 *
 * On phones the overlay line does not float either: it becomes ordinary text
 * beneath the image. Text over a photograph is a contrast gamble at the best of
 * times, and at 390px there is nowhere for it to go — so the small screen gets
 * the safe version rather than the clever one.
 */
interface Props {
  media: MediaId;
  locale: Locale;
  /** Set into the bottom of the image on wide screens. */
  overlayTitle?: string;
  overlayNote?: string;
  /**
   * Which part of the frame the band must keep when it crops. `top` for a
   * picture whose subject is near the top edge — the band is wider than any of
   * the source files, so something always goes.
   */
  focus?: 'center' | 'top';
  /**
   * Whether the band is height-capped on a wide screen.
   *
   * True suits a frame close to 3:2 or squarer, which would otherwise run past
   * the fold. Pass false for something already cropped panoramic: capping the
   * height of a 4:1 strip does not shorten it, it magnifies it and throws the
   * sides away.
   */
  capHeight?: boolean;
  class?: string;
}

const {
  media,
  locale,
  overlayTitle,
  overlayNote,
  focus = 'center',
  capHeight = true,
  class: className = '',
} = Astro.props;

const hasOverlay = Boolean(overlayTitle || overlayNote);
const focusValue = focus === 'top' ? '50% 15%' : '50% 50%';
---

<figure class:list={['fb', className]}>
  <div
    class:list={['fb-frame', hasOverlay && 'fb-frame--scrim', capHeight && 'fb-frame--capped']}
    style={`--media-focus:${focusValue}`}
  >
    <Placeholder id={media} locale={locale} radius="none" />

    {
      hasOverlay && (
        <figcaption class="fb-overlay">
          {overlayTitle && <p class="fb-overlay-title">{overlayTitle}</p>}
          {overlayNote && <p class="fb-overlay-note">{overlayNote}</p>}
        </figcaption>
      )
    }
  </div>
</figure>

<style>
  .fb {
    position: relative;
    margin: 0;
  }

  .fb-frame {
    position: relative;
    overflow: hidden;
  }

  .fb-overlay {
    display: grid;
    gap: 0.3rem;
    /* Below the image on phones, so it sits in the page column like any other
       text rather than starting at the very edge of the screen. */
    padding: 1.25rem var(--gutter) 0;
  }

  .fb-overlay-title {
    font-size: clamp(1.875rem, 4vw, 3rem);
    font-weight: 350;
    letter-spacing: -0.028em;
    line-height: 1.08;
    color: var(--ink);
  }

  .fb-overlay-note {
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }

  @media (width >= 56rem) {
    /* Height-capped instead of aspect-locked, so the band ends within one
       screen. `svh` rather than `vh` because on mobile browsers `vh` measures
       the viewport with the toolbars retracted, which is taller than what is
       actually on screen. */
    .fb-frame--capped :global(.media) {
      aspect-ratio: auto;
      block-size: min(76svh, 42rem);
    }

    .fb-overlay {
      position: absolute;
      inset-inline: clamp(1.5rem, 4vw, 3rem);
      bottom: clamp(1.5rem, 4vw, 3rem);
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 2rem;
      padding-top: 0;
    }

    .fb-overlay-title,
    .fb-overlay-note {
      color: #fff;
    }

    /* A gradient scrim, so the text stays legible whatever the photograph
       turns out to be — without it this depends on getting lucky, and the
       first photograph to land here put white text over a white van. Weighted
       towards the bottom edge so it darkens the line the text sits on without
       flattening the picture above it.

       Only drawn when there is actually text to protect. A band with no
       overlay gets the photograph undimmed. */
    .fb-frame--scrim::after {
      content: '';
      position: absolute;
      inset-inline: 0;
      bottom: 0;
      height: 60%;
      pointer-events: none;
      background-image: linear-gradient(
        to top,
        rgb(10 12 16 / 0.78),
        rgb(10 12 16 / 0.34) 38%,
        transparent
      );
    }
  }
</style>
