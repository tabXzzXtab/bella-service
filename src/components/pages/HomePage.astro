---
import BeforeAfter from '../BeforeAfter.astro';
import Button from '../Button.astro';
import Estimator from '../Estimator.astro';
import LogoCloud from '../LogoCloud.astro';
import Placeholder from '../Placeholder.astro';
import Section from '../Section.astro';
import ServiceCard from '../ServiceCard.astro';
import { featuredServices } from '../../data/services';
import { pillars, stats } from '../../data/site';
import { path, pick, useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/config';

/**
 * The start page.
 *
 * Sequenced as an argument: what we protect (hero) → that we have done it
 * before (stats) → why it matters (mission) → proof (before/after) → what it
 * costs (services, estimator) → the free way in (CTA). Every section points at
 * the free inspection, which is the only conversion goal on this site.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

{/* --- Hero ------------------------------------------------------------- */}
<section class="hero">
  <div class="container-page">
    <div class="hero-copy">
      <p class="label">{t('home.hero.eyebrow')}</p>
      <h1>{t('home.hero.title')}</h1>
      <p class="lead">{t('home.hero.lead')}</p>
      <div class="hero-actions">
        <Button href={path('contact', locale)} variant="accent" size="lg">
          {t('common.getQuote')}
        </Button>
        <Button href={path('process', locale)} variant="ghost" size="lg">
          {t('nav.process')}
        </Button>
      </div>
    </div>

    <div class="hero-media">
      <Placeholder id="homeHero" locale={locale} radius="lg" priority />
    </div>
  </div>
</section>

{/* --- Logo cloud, where the stats used to sit -------------------------- */}
<LogoCloud locale={locale} />

{/* --- Mission + pillars ------------------------------------------------ */}
<Section
  label={t('home.mission.eyebrow')}
  title={t('home.mission.title')}
  lead={t('home.mission.lead')}
>
  <ul class="pillars">
    {
      pillars.map((pillar, index) => (
        <li class="pillar reveal" style={`--reveal-delay:${index * 80}ms`}>
          <h3>{pick(pillar.title, locale)}</h3>
          <p class="muted">{pick(pillar.body, locale)}</p>
        </li>
      ))
    }
  </ul>

  <dl class="stats-grid" aria-label={t('home.stats.title')}>
    {
      stats.map((stat, index) => (
        <div class="stat reveal" style={`--reveal-delay:${index * 80}ms`}>
          <dt class="stat-value">{stat.value}</dt>
          <dd class="stat-label">{pick(stat.label, locale)}</dd>
        </div>
      ))
    }
  </dl>
</Section>

{/* --- The transformation ----------------------------------------------- */}
<Section
  tone="sunk"
  label={t('home.transformation.eyebrow')}
  title={t('home.transformation.title')}
  lead={t('home.transformation.lead')}
>
  <div class="reveal">
    <BeforeAfter locale={locale} />
  </div>
</Section>

{/* --- Services --------------------------------------------------------- */}
<Section
  label={t('home.services.eyebrow')}
  title={t('home.services.title')}
  lead={t('home.services.lead')}
>
  <ul class="svc-grid">
    {
      featuredServices.map((service, index) => (
        <li class="reveal" style={`--reveal-delay:${index * 60}ms`}>
          <ServiceCard service={service} locale={locale} />
        </li>
      ))
    }
  </ul>

  <p class="svc-more">
    <a href={path('services', locale)} class="textlink">{t('home.services.all')}</a>
  </p>
</Section>

{/* --- Estimator -------------------------------------------------------- */}
<Section tone="sunk" label={t('estimator.eyebrow')} title={t('estimator.title')}>
  <div class="est-wrap reveal">
    <Estimator locale={locale} />
    <p class="est-aside lead">{t('estimator.lead')}</p>
  </div>
</Section>

{/* --- Closing CTA ------------------------------------------------------ */}
<section class="closer">
  <div class="container-page closer-inner reveal">
    <h2>{t('home.cta.title')}</h2>
    <p class="closer-lead">{t('home.cta.lead')}</p>
    <Button href={path('contact', locale)} variant="onDark" size="lg">
      {t('common.bookInspection')}
    </Button>
  </div>
</section>

<style>
  /* --- Hero -------------------------------------------------------------- */
  .hero {
    padding-block: clamp(3rem, 7vw, 6rem) clamp(3rem, 6vw, 5rem);
  }

  .hero .container-page {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
  }

  @media (width >= 62rem) {
    .hero .container-page {
      grid-template-columns: 1fr 1fr;
    }
  }

  .hero-copy {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  /* --- Stats -------------------------------------------------------------
   * These sit under the three pillars now, as evidence for the claims made
   * just above them, rather than floating in a band of their own. Hairlines
   * above each figure, no box. */
  .stats-grid {
    display: grid;
    gap: 2rem;
    margin: clamp(3rem, 6vw, 4.5rem) 0 0;
  }

  @media (width >= 40rem) {
    .stats-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2.5rem;
    }
  }

  .stat {
    display: grid;
    gap: 0.35rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .stat-value {
    font-size: clamp(2.25rem, 4.5vw, 3.25rem);
    font-weight: 300;
    letter-spacing: -0.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .stat-label {
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }

  /* --- Pillars ----------------------------------------------------------- */
  .pillars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2rem;
  }

  @media (width >= 48rem) {
    .pillars {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 3rem;
    }
  }

  .pillar {
    display: grid;
    gap: 0.6rem;
    align-content: start;
  }

  .pillar p {
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  /* --- Services ---------------------------------------------------------- */
  .svc-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  @media (width >= 40rem) {
    .svc-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (width >= 68rem) {
    .svc-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .svc-more {
    margin-top: 2rem;
  }

  .textlink {
    font-size: 1rem;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 2px;
    transition: border-color var(--dur-fast) var(--ease);
  }

  .textlink:hover {
    border-bottom-color: var(--accent);
  }

  /* --- Estimator --------------------------------------------------------- */
  .est-wrap {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  @media (width >= 62rem) {
    .est-wrap {
      grid-template-columns: 1fr 0.7fr;
      gap: 4rem;
    }
  }

  .est-aside {
    max-width: 32ch;
  }

  /* --- Closer ------------------------------------------------------------ */
  .closer {
    padding-block: clamp(4rem, 9vw, 7rem);
    background-color: var(--navy);
  }

  .closer-inner {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
    max-width: 34rem;
  }

  .closer h2 {
    color: var(--bg);
  }

  .closer-lead {
    font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
    line-height: 1.5;
    color: rgb(251 250 248 / 0.75);
  }
</style>
