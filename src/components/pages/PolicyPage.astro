---
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import Placeholder from '../Placeholder.astro';
import {
  commitmentCount,
  customerPromises,
  ethics,
  policyIntro,
  policyPillars,
} from '../../data/policy';
import type { Locale } from '../../i18n/config';
import { path, pick, useTranslations } from '../../i18n/utils';

/**
 * "Vår policy" — the company policy, from 1Arbetsmiljöpolysi.docx.
 *
 * The source is a flat Word document of bullet lists. The page gives each of
 * its three parts a different shape, so reading it feels like moving through
 * chapters rather than down one long list:
 *
 *  - Företagspolicy: three pillars, each a sticky title beside a checklist
 *    whose ticks draw in as they arrive. The pillar's big numeral fills with
 *    orange as its list is read, so it doubles as a progress mark.
 *  - Etikpolicy: an inverted band. The zero-tolerance list is set large and
 *    struck through, one word after another.
 *  - Kundpolicy: the five promises in the order a visit happens, from
 *    before we arrive to after we leave, as plain ruled rows. They are about
 *    manners in someone's home; cards made them read like product features.
 *
 * A sticky chapter bar under the header follows the reader and marks where
 * they are.
 *
 * No icon badges. The orange arrives as punctuation instead: a filling
 * numeral, a drawn tick, a strike-through, and a full stop at the end of the
 * page's statements.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const chapters = [
  ...policyPillars.map((pillar) => ({ id: pillar.id, label: pick(pillar.short, locale) })),
  { id: 'etik', label: t('policy.nav.ethics') },
  { id: 'kund', label: t('policy.nav.customer') },
];

const pad = (n: number) => String(n).padStart(2, '0');
---

{/* --- Hero ------------------------------------------------------------- */}
<section class="pl-hero">
  <div class="container-page pl-hero-inner">
    <div class="pl-hero-copy enter" style="--enter-delay:calc(var(--enter-stagger) * 2)">
      <p class="label">{t('policy.hero.eyebrow')}</p>
      <h1>{t('policy.hero.title')}</h1>
      <p class="pl-hero-lead">{pick(policyIntro[0], locale)}</p>
      <p class="muted pl-hero-sub">{pick(policyIntro[1], locale)}</p>
    </div>

    {
      /* The entrance plays on the photo and the glass separately, never on
        this wrapper: a filter on any ancestor of the glass cuts it off from
        the photo behind it, and the frost silently stops working. */
    }
    <aside class="pl-doc" aria-label={t('policy.doc.label')}>
      <div class="pl-doc-photo enter" style="--enter-delay:calc(var(--enter-stagger) * 3)">
        <Placeholder id="crew" locale={locale} radius="lg" priority />
      </div>

      {
        /* Frosted glass over the photograph. Navy-tinted so white text holds
          its contrast whatever part of the frame is behind it. */
      }
      <div class="pl-glass enter" style="--enter-delay:calc(var(--enter-stagger) * 5)">
        <p class="pl-glass-label">{t('policy.doc.label')}</p>

        <ul class="pl-doc-figures">
          <li>
            <span class="pl-doc-figure">{commitmentCount}</span>
            <span class="pl-doc-caption">{t('policy.doc.commitments')}</span>
          </li>
          <li>
            <span class="pl-doc-figure">0</span>
            <span class="pl-doc-caption">{t('policy.doc.zero')}</span>
          </li>
          <li>
            <span class="pl-doc-figure">{customerPromises.length}</span>
            <span class="pl-doc-caption">{t('policy.doc.promises')}</span>
          </li>
        </ul>

        <p class="pl-glass-quote">{pick(ethics.scope, locale)}</p>

        <a href={`#${policyPillars[0].id}`} class="pl-glass-link">
          {t('policy.doc.read')}
          <Icon name="arrowDown" size={16} />
        </a>
      </div>
    </aside>
  </div>
</section>

{/* --- Chapter bar ------------------------------------------------------ */}
<nav class="pl-chapters" aria-label={t('policy.nav.label')} data-chapters>
  <div class="container-page">
    <ol class="pl-chapters-list" data-chapters-list>
      {
        chapters.map((chapter, index) => (
          <li>
            <a href={`#${chapter.id}`} data-chapter-link={chapter.id}>
              <span class="pl-chapters-num">{pad(index + 1)}</span>
              {chapter.label}
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</nav>

{/* --- 1.1 Företagspolicy ----------------------------------------------- */}
<section class="pl-company">
  <div class="container-page">
    <header class="pl-head reveal">
      <p class="label">{t('policy.company.label')}</p>
      <h2>{t('policy.company.title')}</h2>
    </header>

    {
      policyPillars.map((pillar, pillarIndex) => (
        <article id={pillar.id} class="pl-pillar" data-chapter>
          <div class="pl-pillar-aside">
            <div class="pl-pillar-sticky reveal">
              <span class="pl-pillar-num" aria-hidden="true">
                {pad(pillarIndex + 1)}
              </span>
              <h3 class="pl-pillar-title">{pick(pillar.title, locale)}</h3>
              <p class="pl-pillar-intro">{t('policy.company.intro')}</p>
            </div>
          </div>

          <ol class="pl-checklist">
            {pillar.items.map((item) => (
              <li class="pl-check reveal">
                <svg class="pl-check-mark" viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="12" cy="12" r="11" pathLength="1" />
                  <path d="m7.5 12.5 3 3 6-6.5" pathLength="1" />
                </svg>
                <div>
                  <h4 class="pl-check-title">{pick(item.title, locale)}</h4>
                  <p class="pl-check-body">{pick(item.body, locale)}</p>
                </div>
              </li>
            ))}
          </ol>
        </article>
      ))
    }
  </div>
</section>

{/* --- 1.2 Etikpolicy --------------------------------------------------- */}
<section id="etik" class="pl-ethics" data-chapter>
  <div class="container-page">
    <div class="pl-ethics-top reveal">
      <p class="pl-ethics-label">{t('policy.ethics.label')}</p>
      <h2 class="pl-ethics-zero">
        {t('policy.ethics.zero')}<span class="pl-stop">.</span>
      </h2>
      <p class="pl-ethics-zero-lead">{t('policy.ethics.zeroLead')}</p>
    </div>

    <ul class="pl-struck reveal">
      {
        ethics.zeroTolerance.map((word, index) => (
          <li style={`--i:${index}`}>
            <span>{pick(word, locale)}</span>
          </li>
        ))
      }
    </ul>

    <p class="pl-ethics-lead reveal">{pick(ethics.lead, locale)}</p>

    <ul class="pl-principles">
      {
        ethics.principles.map((item, index) => (
          <li class="pl-principle reveal" style={`--reveal-delay:${index * 80}ms`}>
            <h3 class="pl-principle-title">{pick(item.title, locale)}</h3>
            <p class="pl-principle-body">{pick(item.body, locale)}</p>
          </li>
        ))
      }
    </ul>

    <blockquote class="pl-ethics-quote reveal">
      <p>{pick(ethics.closing, locale)}</p>
    </blockquote>
  </div>
</section>

{/* --- 1.3 Kundpolicy --------------------------------------------------- */}
<section id="kund" class="pl-customer" data-chapter>
  <div class="container-page">
    <header class="pl-head reveal">
      <p class="label">{t('policy.customer.label')}</p>
      <h2>{t('policy.customer.title')}</h2>
      <p class="lead">{t('policy.customer.lead')}</p>
    </header>

    <ol class="pl-visit">
      {
        customerPromises.map((promise, index) => (
          <li class="pl-visit-row reveal" style={`--reveal-delay:${index * 70}ms`}>
            <p class="pl-visit-moment">{pick(promise.moment, locale)}</p>
            <h3 class="pl-visit-title">
              {pick(promise.title, locale)}
              <span class="pl-stop">.</span>
            </h3>
            <p class="pl-visit-body">{pick(promise.body, locale)}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

{/* --- Closing CTA ------------------------------------------------------ */}
<section class="pl-closer">
  <div class="container-page pl-closer-inner reveal">
    <h2>{t('policy.cta.title')}</h2>
    <p class="lead">{t('policy.cta.lead')}</p>
    <div class="pl-closer-actions">
      <Button href={path('contact', locale)} variant="primary" size="lg">
        {t('common.bookInspection')}
      </Button>
      <Button href={path('services', locale)} variant="ghost" size="lg">
        {t('common.seeServices')}
      </Button>
    </div>
  </div>
</section>

<style>
  /* --- Hero -------------------------------------------------------------- */
  .pl-hero {
    padding-block: clamp(3rem, 7vw, 6rem) clamp(2.5rem, 5vw, 4rem);
  }

  .pl-hero-inner {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  @media (width >= 56rem) {
    .pl-hero-inner {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      align-items: end;
      gap: 5rem;
    }
  }

  .pl-hero-copy {
    display: grid;
    gap: 1.25rem;
  }

  .pl-hero-lead {
    font-size: clamp(1.0625rem, 1.4vw, 1.3125rem);
    line-height: 1.5;
    letter-spacing: -0.012em;
    max-width: 44ch;
  }

  .pl-hero-sub {
    font-size: 0.9375rem;
    max-width: 52ch;
  }

  /* The summary box: the crew photograph with a glass panel floating over
     its lower half. Portrait, so the frame crops to the people rather than to
     the van beside them. */
  .pl-doc {
    position: relative;
    display: grid;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }

  .pl-doc-photo {
    grid-area: 1 / 1;
    --media-focus: 78% 40%;
  }

  /* Taller on phones, where the glass takes a bigger share of the width and
     would otherwise sit over the crew's faces. */
  .pl-doc-photo :global(.media) {
    aspect-ratio: 2 / 3;
  }

  @media (width >= 56rem) {
    .pl-doc-photo :global(.media) {
      aspect-ratio: 4 / 5;
    }
  }

  .pl-glass {
    grid-area: 1 / 1;
    align-self: end;
    display: grid;
    gap: 1.25rem;
    margin: 0.75rem;
    padding: clamp(1.25rem, 2.4vw, 1.75rem);
    /* Rounder than any other surface on the site: this is the one bubble. */
    border-radius: calc(var(--radius-lg) + 0.5rem);
    color: var(--surface);
    /*
     * A bubble, in layers, top to bottom:
     *  1. a specular highlight in the upper left, where light hits a curve;
     *  2. warm orange light pooling along the lower edge, as if the sun were
     *     coming through the glass. The brand colour arrives as light, not
     *     paint;
     *  3. the navy frost the white text actually sits on.
     */
    background:
      radial-gradient(
        120% 70% at 12% 0%,
        color-mix(in srgb, var(--surface) 30%, transparent) 0%,
        transparent 55%
      ),
      radial-gradient(
        90% 55% at 70% 115%,
        color-mix(in srgb, var(--accent) 55%, transparent) 0%,
        transparent 70%
      ),
      color-mix(in srgb, var(--navy) 62%, transparent);
    /* Standard property only; the build adds a prefix where one is needed.
       Writing both let the minifier keep just the -webkit- one, which Chrome
       ignores. */
    backdrop-filter: blur(22px) saturate(170%);
    border: 1px solid color-mix(in srgb, var(--surface) 28%, transparent);
    /* The roundness: a bright rim along the top, a sheen that falls off
       inside it, a faint reflected edge at the bottom, then the lift. */
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--surface) 60%, transparent),
      inset 0 22px 28px -22px color-mix(in srgb, var(--surface) 40%, transparent),
      inset 0 -1px 0 color-mix(in srgb, var(--accent) 45%, transparent),
      inset 0 -26px 36px -26px color-mix(in srgb, var(--accent) 50%, transparent),
      0 18px 40px -18px color-mix(in srgb, var(--ink) 55%, transparent),
      0 14px 44px -22px color-mix(in srgb, var(--accent) 55%, transparent);
  }

  /* Without backdrop-filter the frost cannot happen, so the tint deepens
     enough to carry white text on its own. */
  @supports not (backdrop-filter: blur(1px)) {
    .pl-glass {
      background-color: color-mix(in srgb, var(--navy) 90%, transparent);
    }
  }

  .pl-glass-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--surface);
  }

  .pl-doc-figures {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pl-doc-figures li {
    display: grid;
    gap: 0.35rem;
    align-content: start;
  }

  .pl-doc-figure {
    font-size: clamp(2.25rem, 4vw, 3rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    color: var(--surface);
  }

  .pl-doc-caption {
    font-size: 0.8125rem;
    line-height: 1.35;
    color: var(--surface);
  }

  .pl-glass-quote {
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--surface) 25%, transparent);
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: -0.015em;
    text-wrap: balance;
    color: var(--surface);
  }

  .pl-glass-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    justify-self: start;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--surface);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--surface) 45%, transparent);
    text-underline-offset: 0.25em;
    transition: text-decoration-color var(--dur-fast) var(--ease);
  }

  .pl-glass-link:hover {
    text-decoration-color: var(--accent);
  }

  /* --- Chapter bar --------------------------------------------------------
     Sticks directly under the site header (whose row is 4.25rem tall). */
  .pl-chapters {
    position: sticky;
    top: 4.25rem;
    z-index: 70;
    background-color: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: blur(14px) saturate(160%);
    border-block: 1px solid var(--line);
  }

  .pl-chapters-list {
    display: flex;
    gap: 0.375rem;
    margin: 0;
    padding: 0.625rem 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
    /* Let the pills scroll out to the screen edge on phones instead of being
       clipped at the gutter. */
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
    scroll-padding-inline: var(--gutter);
  }

  .pl-chapters-list::-webkit-scrollbar {
    display: none;
  }

  @media (width >= 48rem) {
    .pl-chapters-list {
      margin-inline: 0;
      padding-inline: 0;
    }
  }

  .pl-chapters-list a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.5rem;
    padding: 0 1rem;
    border-radius: var(--radius-pill);
    font-size: 0.9375rem;
    font-weight: 450;
    white-space: nowrap;
    text-decoration: none;
    color: var(--ink-soft);
    transition:
      background-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .pl-chapters-list a:hover {
    color: var(--ink);
    background-color: var(--bg-sunk);
  }

  .pl-chapters-list a[aria-current='true'] {
    background-color: var(--ink);
    color: var(--bg);
  }

  .pl-chapters-num {
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    opacity: 0.6;
  }

  /* Anchors land below both the header and the chapter bar. */
  [data-chapter] {
    scroll-margin-top: 8.5rem;
  }

  /* --- Shared section head ----------------------------------------------- */
  .pl-head {
    display: grid;
    gap: 1rem;
    max-width: 36rem;
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }

  /* --- 1.1 Pillars ------------------------------------------------------- */
  .pl-company {
    padding-block: var(--section-pad) calc(var(--section-pad) * 0.6);
  }

  .pl-pillar {
    display: grid;
    gap: 1.75rem;
    padding-block: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--line);
  }

  @media (width >= 56rem) {
    .pl-pillar {
      grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
      gap: 5rem;
    }

    /* The pillar's title rides alongside its list while it is read. */
    .pl-pillar-sticky {
      position: sticky;
      top: 10rem;
    }
  }

  .pl-pillar-sticky {
    display: grid;
    justify-items: start;
    gap: 0.75rem;
  }

  .pl-pillar-num {
    font-size: clamp(3.5rem, 8vw, 5.5rem);
    font-weight: 250;
    line-height: 0.9;
    letter-spacing: -0.05em;
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
    margin-bottom: 0.75rem;
  }

  /* The numeral fills with orange from the bottom as the pillar scrolls past:
     empty when its list arrives, full when the last item has been read. Where
     scroll timelines are unsupported, or motion is reduced, it stays a quiet
     grey numeral, which is also what it was designed to be at rest. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .pl-pillar {
        view-timeline-name: --pillar;
      }

      .pl-pillar-num {
        color: transparent;
        background-image: linear-gradient(to top, var(--accent) 50%, var(--line-strong) 50%);
        background-size: 100% 200%;
        background-position: 0 0;
        -webkit-background-clip: text;
        background-clip: text;
        /* Longhands on purpose: the minifier folds a shorthand plus
           animation-timeline into one `animation` value that browsers reject. */
        animation-name: pl-fill;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --pillar;
        animation-range: cover 20% cover 70%;
      }
    }
  }

  @keyframes pl-fill {
    to {
      background-position: 0 100%;
    }
  }

  .pl-pillar-title {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 400;
    letter-spacing: -0.025em;
  }

  .pl-pillar-intro {
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }

  .pl-checklist {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pl-check {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  .pl-check:first-child {
    padding-top: 0;
  }

  .pl-check:last-child {
    border-bottom: 0;
  }

  .pl-check-title {
    font-size: clamp(1.0625rem, 1.5vw, 1.1875rem);
    margin-bottom: 0.4rem;
  }

  .pl-check-body {
    color: var(--ink-soft);
    font-size: 0.9375rem;
    line-height: 1.6;
    max-width: var(--measure);
  }

  /* The tick. Drawn, not faded: the ring closes, then the check strokes in.
     Only hidden when JS is present to reveal it again. */
  .pl-check-mark {
    width: 1.75rem;
    height: 1.75rem;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .pl-check-mark circle {
    stroke: var(--line-strong);
    stroke-width: 1.25;
  }

  .pl-check-mark path {
    stroke: var(--accent);
    stroke-width: 2;
  }

  :global(.js) .pl-check-mark circle,
  :global(.js) .pl-check-mark path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset var(--dur-slow) var(--ease-entrance);
  }

  :global(.js) .pl-check-mark circle {
    transition-delay: calc(var(--dur-fast) * 1);
  }

  :global(.js) .pl-check-mark path {
    transition-delay: calc(var(--dur-fast) * 3);
  }

  :global(.js) .pl-check.is-visible .pl-check-mark circle,
  :global(.js) .pl-check.is-visible .pl-check-mark path {
    stroke-dashoffset: 0;
  }

  /* --- 1.2 Ethics -------------------------------------------------------- */
  .pl-ethics {
    padding-block: var(--section-pad);
    background-color: var(--navy);
    color: var(--bg);
    overflow: hidden;
  }

  .pl-ethics-top {
    display: grid;
    gap: 1rem;
  }

  .pl-ethics-label {
    font-size: 0.9375rem;
    font-weight: 500;
    color: color-mix(in srgb, var(--bg) 72%, transparent);
  }

  .pl-ethics-zero {
    font-size: clamp(3.25rem, 11vw, 9rem);
    font-weight: 250;
    letter-spacing: -0.05em;
    line-height: 0.95;
    color: var(--bg);
  }

  .pl-ethics-zero-lead {
    font-size: clamp(1.0625rem, 1.4vw, 1.3125rem);
    color: color-mix(in srgb, var(--bg) 72%, transparent);
  }

  /* The zero-tolerance words, each struck out in turn as the list arrives. */
  .pl-struck {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .pl-struck span {
    position: relative;
    display: inline-block;
    font-size: clamp(1.5rem, 3.4vw, 2.5rem);
    font-weight: 300;
    letter-spacing: -0.03em;
    color: color-mix(in srgb, var(--bg) 60%, transparent);
  }

  .pl-struck span::after {
    content: '';
    position: absolute;
    left: -0.1em;
    right: -0.1em;
    top: 55%;
    height: 0.075em;
    border-radius: var(--radius-pill);
    background-color: var(--accent);
    transform-origin: left center;
  }

  :global(.js) .pl-struck span::after {
    transform: scaleX(0);
    transition: transform var(--dur-slow) var(--ease-entrance);
    transition-delay: calc(var(--dur-fast) * 2 + var(--i) * var(--enter-stagger) * 1.5);
  }

  :global(.js) .pl-struck.is-visible span::after {
    transform: scaleX(1);
  }

  .pl-ethics-lead {
    margin-top: clamp(3.5rem, 8vw, 6rem);
    max-width: 30ch;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 300;
    line-height: 1.25;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .pl-principles {
    display: grid;
    gap: 0;
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    padding: 0;
