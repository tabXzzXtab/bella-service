---
import Logo from './Logo.astro';
import { NAV_ORDER, type Locale, type RouteKey } from '../i18n/config';
import type { UIKey } from '../i18n/ui';
import { formatAddress, site } from '../data/site';
import { path, pick, useTranslations } from '../i18n/utils';

/**
 * Site footer.
 *
 * Carries the trust markers that decide the sale in this trade — a real org
 * number, F-skatt approval, a street address, a phone number a person answers.
 * A roofing company that hides those looks like one that will not be there
 * next spring.
 *
 * Set quietly: small type, one hairline, no icons. The footer is reference
 * material, not a second navigation experience.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const NAV_LABEL: Record<RouteKey, UIKey> = {
  home: 'nav.home',
  services: 'nav.services',
  process: 'nav.process',
  contact: 'nav.contact',
};

const year = new Date().getFullYear();
---

<footer class="ftr">
  <div class="container-page">
    <div class="ftr-grid">
      <div class="ftr-brand">
        <Logo size="md" />
        <p class="ftr-tagline">{pick(site.tagline, locale)}</p>
      </div>

      <nav class="ftr-col" aria-label={t('footer.navTitle')}>
        <h2 class="ftr-heading">{t('footer.navTitle')}</h2>
        <ul>
          {
            NAV_ORDER.map((key) => (
              <li>
                <a href={path(key, locale)}>{t(NAV_LABEL[key])}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="ftr-col">
        <h2 class="ftr-heading">{t('footer.contactTitle')}</h2>
        <ul>
          <li><a href={`tel:${site.phone.href}`}>{site.phone.display}</a></li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li class="ftr-plain">{pick(site.openingHours, locale)}</li>
          <li class="ftr-plain">{pick(site.serviceArea, locale)}</li>
        </ul>
      </div>

      <div class="ftr-col">
        <h2 class="ftr-heading">{t('footer.companyTitle')}</h2>
        <ul>
          <li class="ftr-plain">{site.legalName}</li>
          <li class="ftr-plain">{formatAddress(site.address)}</li>
          <li class="ftr-plain">{t('common.orgNumber')} {site.orgNumber}</li>
          {site.approvedForFTax && <li class="ftr-plain">{t('footer.fTax')}</li>}
        </ul>
      </div>
    </div>

    <hr class="rule ftr-rule" />

    <p class="ftr-legal">© {year} {site.legalName}. {t('footer.rights')}</p>
  </div>
</footer>

<style>
  .ftr {
    padding-block: clamp(3.5rem, 7vw, 5.5rem) 2rem;
    /* Clears the floating mobile action bar so the last line is never hidden. */
    padding-bottom: 6rem;
    border-top: 1px solid var(--line);
  }

  @media (width >= 48rem) {
    .ftr {
      padding-bottom: 2.5rem;
    }
  }

  .ftr-grid {
    display: grid;
    gap: 2.5rem;
  }

  @media (width >= 40rem) {
    .ftr-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (width >= 64rem) {
    .ftr-grid {
      grid-template-columns: 1.5fr 0.8fr 1.1fr 1.1fr;
      gap: 3rem;
    }
  }

  .ftr-tagline {
    margin-top: 0.9rem;
    max-width: 24ch;
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }

  .ftr-heading {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink);
    margin-bottom: 0.9rem;
  }

  .ftr-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }

  .ftr-col a {
    text-decoration: none;
    color: var(--ink-soft);
    transition: color var(--dur-fast) var(--ease);
  }

  .ftr-col a:hover {
    color: var(--ink);
  }

  .ftr-rule {
    margin-block: clamp(2.5rem, 5vw, 3.5rem) 1.25rem;
  }

  .ftr-legal {
    font-size: 0.875rem;
    color: var(--ink-faint);
  }
</style>
