---
import Button from './Button.astro';
import { services } from '../data/services';
import { site } from '../data/site';
import { requestWebhooks, RESPONSE_HOURS, type RequestKind } from '../data/webhooks';
import { pick, useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/config';

/**
 * A call to action that opens into a short form in place.
 *
 * The button does not navigate. Pressing it collapses the label and unfolds
 * the fields underneath it, so the visitor never leaves the section they were
 * reading. Keep it to the fewest fields that make an enquiry answerable: a way
 * to reach them, and — where the surrounding section has not already asked —
 * what the job is.
 *
 * Two kinds, and they post to different automations:
 *
 *  - `simple`   just the address. The start page hero.
 *  - `detailed` the address plus whatever the surrounding panel has collected.
 *
 * How it picks up those details: it walks up to the nearest
 * `[data-request-context]` and reads every `[data-request-field]` inside it.
 * That keeps this component ignorant of the price panel's markup — a panel
 * opts in by naming its fields, and this one never has to know what a service
 * or a square metre is.
 *
 * Without JavaScript the button does nothing at all, which is why it is only
 * ever rendered beside a real link to the contact page. The form there is the
 * path that always works.
 */
interface Props {
  locale: Locale;
  /** Text on the closed button. */
  label: string;
  kind: RequestKind;
  variant?: 'accent' | 'primary' | 'onDark';
  size?: 'md' | 'lg';
  /** Unique per instance — two captures can share a page. */
  id: string;
  /**
   * Ask for a phone number as well as an address. On by default: for this
   * trade most enquiries are settled in a two-minute call, and the client's
   * brief marks the number required on the full form for the same reason.
   */
  withPhone?: boolean;
  /**
   * Ask which service they want. Only for a capture that stands on its own —
   * inside the price panel the section has already asked, and a second select
   * would be the same question twice.
   */
  withService?: boolean;
  /**
   * Where the button goes when there is no JavaScript. Rendered inside
   * <noscript>, and the interactive half is hidden in the same case, so the
   * call to action is never a button that does nothing.
   */
  fallbackHref?: string;
  class?: string;
}

const {
  locale,
  label,
  kind,
  variant = 'accent',
  size = 'lg',
  id,
  withPhone = true,
  withService = false,
  fallbackHref,
  class: className = '',
} = Astro.props;

const t = useTranslations(locale);
---

<div
  class:list={['ec', variant === 'onDark' && 'ec--onDark', className]}
  data-email-capture
  data-request-context={withService ? '' : undefined}
  data-state="idle"
  data-kind={kind}
  data-endpoint={requestWebhooks[kind]}
  data-locale={locale}
  data-hours={String(RESPONSE_HOURS)}
  data-label-send={t('quote.send')}
  data-label-sending={t('quote.sending')}
  data-msg-invalid={t('quote.invalid')}
  data-msg-invalid-phone={t('quote.invalidPhone')}
  data-msg-error={t('quote.error')}
  data-phone-display={site.phone.display}
  data-phone-href={site.phone.href}
  data-msg-success-title={t('quote.successTitle')}
  data-msg-success-body={t('quote.successBody')}
>
  <div class="ec-trigger">
    <Button type="button" variant={variant} size={size} data-ec-open>{label}</Button>
  </div>

  {
    /* Unfolds downward rather than sideways: three fields do not fit on one
      line at 390px, and a form that has to wrap mid-animation reads as a
      glitch rather than as an opening. */
  }
  <div class="ec-reveal">
    <div class="ec-reveal-inner">
      <form class:list={['ec-form', withPhone && 'ec-form--pair']} data-ec-form novalidate>
        {
          withService && (
            <select
              id={`${id}-service`}
              class="ec-input"
              aria-label={t('quote.serviceLabel')}
              data-request-field="tjanst"
            >
              {services.map((service) => (
                <option value={service.id}>{pick(service.title, locale)}</option>
              ))}
            </select>
          )
        }

        <input
          id={`${id}-email`}
          class="ec-input"
          type="email"
          name="email"
          inputmode="email"
          autocomplete="email"
          spellcheck="false"
          placeholder={t('quote.emailPlaceholder')}
          aria-label={t('quote.emailLabel')}
          required
          data-ec-email
        />

        {
          withPhone && (
            <input
              id={`${id}-phone`}
              class="ec-input"
              type="tel"
              name="phone"
              inputmode="tel"
              autocomplete="tel"
              placeholder={t('quote.phonePlaceholder')}
              aria-label={t('quote.phoneLabel')}
              required
              data-ec-phone
            />
          )
        }

        <Button type="submit" variant={variant} size={size} data-ec-submit>
          {t('quote.send')}
        </Button>
      </form>
    </div>
  </div>

  <p class="ec-status" data-ec-status role="status" aria-live="polite"></p>

  {
    fallbackHref && (
      <noscript>
        <Button href={fallbackHref} variant={variant} size={size}>
          {label}
        </Button>
      </noscript>
    )
  }
</div>

<script>
  /**
   * Inline quote capture.
   *
   * One listener set per instance, and there can be more than one instance on
   * a page — this is a bundled component script, so it is delivered once no
   * matter how many times the component renders.
   *
   * Everything it needs is on the element as data attributes: the endpoint,
   * the locale and every string. Nothing is duplicated into the bundle, and
   * the Swedish and English pages ship the same JavaScript.
   */
  const EMAIL_PATTERN = /^[^\s@]+@[^\s@.]+(\.[^\s@.]+)+$/;

  /**
   * Swedish numbers get written 0733-987 868, +46 733 98 78 68, 0733987868 …
   * so rather than pattern-match a format, require enough digits to be
   * dialable. Same rule as the full form in src/lib/contact.ts.
   */
  const MIN_PHONE_DIGITS = 6;

  function countDigits(value: string): number {
    let digits = 0;
    for (const character of value) {
      if (character >= '0' && character <= '9') digits += 1;
    }
    return digits;
  }

  /** Read a motion token so a JS delay cannot drift from the CSS it waits on. */
  function motionMs(name: string, fallback: number): number {
    const raw = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    const value = Number.parseFloat(raw);
    if (!Number.isFinite(value)) return fallback;
    return raw.endsWith('ms') ? value : value * 1000;
  }

  /**
   * Whatever the surrounding panel has already collected.
   *
   * The contract is one attribute: anything carrying `data-request-field`
   * inside the nearest `[data-request-context]` is sent under that name. A
   * <select> also sends its visible label, because an id like `taktvatt` is
   * not what anyone wants to read in an e-mail.
   */
  function collectDetails(root: HTMLElement): Record<string, string> {
    const details: Record<string, string> = {};
    const context = root.closest('[data-request-context]');
    if (!context) return details;

    context.querySelectorAll<HTMLElement>('[data-request-field]').forEach((field) => {
      const key = field.dataset.requestField;
      if (!key) return;

      if (field instanceof HTMLSelectElement) {
        details[key] = field.value;
        const option = field.selectedOptions[0];
        if (option) details[`${key}Label`] = (option.textContent ?? '').trim();
        return;
      }

      details[key] =
        field instanceof HTMLInputElement ? field.value : (field.textContent ?? '').trim();
    });

    return details;
  }

  document.querySelectorAll<HTMLElement>('[data-email-capture]').forEach((root) => {
    const openButton = root.querySelector<HTMLButtonElement>('[data-ec-open]');
    const form = root.querySelector<HTMLFormElement>('[data-ec-form]');
    const email = root.querySelector<HTMLInputElement>('[data-ec-email]');
    // Optional: a caller can ask for either, both or neither.
    const phone = root.querySelector<HTMLInputElement>('[data-ec-phone]');
    const service = root.querySelector<HTMLSelectElement>('[data-request-field="tjanst"]');
    const submit = root.querySelector<HTMLButtonElement>('[data-ec-submit]');
    const status = root.querySelector<HTMLElement>('[data-ec-status]');

    if (!openButton || !form || !email || !submit || !status) return;

    const endpoint = root.dataset.endpoint ?? '';
    const sendLabel = root.dataset.labelSend ?? '';

    const phoneDisplay = root.dataset.phoneDisplay ?? '';
    const phoneHref = root.dataset.phoneHref ?? '';

    /**
     * Writes the status line, turning `{phone}` into a real tel: link.
     *
     * Built as nodes rather than assigned as innerHTML: these strings come
     * from the dictionary, but a status line that accepts markup is a habit
     * that eventually meets a string somebody else controls.
     */
    const say = (text: string, title?: string) => {
      status.textContent = '';

      if (title) {
        const heading = document.createElement('strong');
        heading.textContent = title;
        status.append(heading);
      }

      const parts = text.split('{phone}');
      parts.forEach((part, index) => {
        if (part) status.append(document.createTextNode(part));
        if (index === parts.length - 1 || !phoneHref) return;

        const call = document.createElement('a');
        call.href = `tel:${phoneHref}`;
        call.textContent = phoneDisplay;
        status.append(call);
      });
    };

    const setTone = (tone: 'error' | null) => {
      if (tone) root.dataset.tone = tone;
      else delete root.dataset.tone;
    };

    openButton.addEventListener('click', () => {
      root.dataset.state = 'open';
      say('');
      setTone(null);
      // After the unfold, not during it: focusing a field inside a box that
      // is still zero pixels tall makes the browser scroll to a point that is
      // about to move. First field, whichever the caller asked for first.
      const first = service ?? email;
      window.setTimeout(() => first.focus(), motionMs('--dur', 260));
    });

    root.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || root.dataset.state !== 'open') return;
      root.dataset.state = 'idle';
      say('');
      setTone(null);
      openButton.focus();
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const address = email.value.trim();
      if (!EMAIL_PATTERN.test(address)) {
        setTone('error');
        say(root.dataset.msgInvalid ?? '');
        email.focus();
        return;
      }

      const number = phone ? phone.value.trim() : '';
      if (phone && countDigits(number) < MIN_PHONE_DIGITS) {
        setTone('error');
        say(root.dataset.msgInvalidPhone ?? '');
        phone.focus();
        return;
      }

      root.dataset.state = 'sending';
      setTone(null);
      submit.disabled = true;
      submit.textContent = root.dataset.labelSending ?? sendLabel;

      const hours = Number(root.dataset.hours) || 48;
      const now = new Date();

      const payload = {
        kind: root.dataset.kind,
        email: address,
        phone: number,
        locale: root.dataset.locale,
        page: window.location.href,
        submittedAt: now.toISOString(),
        responseHours: hours,
        // A convenience only. The promise is counted from the moment the
        // confirmation is SENT, so the workflow should recompute this itself
        // rather than trust a clock it does not control.
        respondBy: new Date(now.getTime() + hours * 60 * 60 * 1000).toISOString(),
        details: collectDetails(root),
      };

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          // text/plain keeps this a CORS "simple" request. application/json
          // would make the browser send a preflight OPTIONS first, which the
          // webhook would then also have to answer.
          headers: { 'Content-Type': 'text/plain;charset=UTF-8' },
          body: JSON.stringify(payload),
        });

        if (!response.ok) throw new Error(String(response.status));

        root.dataset.state = 'sent';
        say(root.dataset.msgSuccessBody ?? '', root.dataset.msgSuccessTitle ?? '');
      } catch {
        // Back to the open field rather than to the button: their address is
        // still typed, and a retry should not cost them the typing.
        root.dataset.state = 'open';
        setTone('error');
        say(root.dataset.msgError ?? '');
        submit.disabled = false;
        submit.textContent = sendLabel;
      }
    });
  });
</script>

<style>
  .ec {
    display: grid;
    gap: 0.6rem;
    justify-items: start;
    min-width: 0;
  }

  /* `.js` is set by an inline script in <head> before first paint. Without it
     neither half appears and the <noscript> link is the whole control. */
  :global(html:not(.js)) .ec-trigger,
  :global(html:not(.js)) .ec-reveal {
    display: none;
  }

  /* Both halves collapse along the block axis rather than swapping on one
     line: `0fr` to `1fr` is the one way to animate to a height nobody can
     know in advance, and the form's height depends on how many fields the
     caller asked for. */
  .ec-trigger,
  .ec-reveal {
    display: grid;
    max-width: 100%;
    transition:
      grid-template-rows var(--dur) var(--ease),
      opacity var(--dur-fast) var(--ease);
  }

  .ec-trigger > *,
  .ec-reveal-inner {
    overflow: hidden;
    min-height: 0;
  }

  .ec-trigger {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .ec-reveal {
    grid-template-rows: 0fr;
    opacity: 0;
  }

  .ec[data-state='open'] .ec-trigger,
  .ec[data-state='sending'] .ec-trigger,
  .ec[data-state='sent'] .ec-trigger {
    grid-template-rows: 0fr;
    opacity: 0;
  }

  .ec[data-state='open'] .ec-reveal,
  .ec[data-state='sending'] .ec-reveal {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .ec-form {
    display: grid;
    gap: 0.5rem;
    /* Wide enough for a real address, capped so it cannot push a phone
       layout sideways. The top padding is the gap the collapsed trigger
       leaves behind. */
    padding-top: 0.15rem;
    inline-size: 24rem;
    max-inline-size: min(100%, 82vw);
  }

  /* Once there is room, the two contact fields share a line so the form does
     not become a tall column on a desktop hero. */
  @media (width >= 30rem) {
    .ec-form--pair {
      grid-template-columns: 1fr 1fr;
    }

    .ec-form--pair > :global(select),
    .ec-form--pair > :global(button) {
      grid-column: 1 / -1;
    }
  }

  .ec-input {
    flex: 1 1 auto;
    min-inline-size: 0;
    padding: 0.8rem 0.95rem;
    font-family: inherit;
    font-size: 1rem;
    color: var(--ink);
    background-color: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    transition: border-color var(--dur-fast) var(--ease);
  }

  .ec-input:hover,
  .ec-input:focus-visible {
    border-color: var(--ink-faint);
  }

  .ec-status {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--ink-soft);
  }

  .ec-status:empty {
    display: none;
  }

  /* Underlined and tappable: a send that failed should put a call one tap
     away, not a number to copy out by hand. */
  .ec-status a {
    color: inherit;
    font-weight: 500;
    text-decoration: underline;
  }

  .ec[data-tone='error'] .ec-status {
    color: var(--accent-ink);
  }

  .ec-status strong {
    display: block;
    font-weight: 500;
    color: var(--ink);
  }

  /* On a dark band the field and the helper text have to invert too, or the
     capture is the one element on the panel still dressed for daylight. */
  .ec--onDark .ec-input {
    color: var(--bg);
    background-color: rgb(255 255 255 / 0.08);
    border-color: rgb(255 255 255 / 0.3);
  }

  .ec--onDark .ec-input::placeholder {
    color: rgb(251 250 248 / 0.55);
  }

  .ec--onDark .ec-status {
    color: rgb(251 250 248 / 0.75);
  }

  .ec--onDark .ec-status strong,
  .ec--onDark .ec-status a {
    color: var(--bg);
  }

  @media (prefers-reduced-motion: reduce) {
    .ec-slot {
      transition: none;
    }
  }
</style>
