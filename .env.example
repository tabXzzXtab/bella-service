# Copy to .env and fill in. .env is git-ignored; never commit real credentials.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Canonical origin, no trailing slash. Used for canonical URLs, hreflang and
# sitemap.xml. Must match the domain the site is actually served from.
SITE_URL="https://bellaserviceab.se"

# Sub-path the site is served from. Leave as "/" unless the site lives under a
# folder — the GitHub Pages workflow sets this to "/<repo>/" automatically.
BASE_PATH="/"

# ---------------------------------------------------------------------------
# Contact form mail delivery
# ---------------------------------------------------------------------------
# Leave these empty during development: the contact endpoint will print
# submissions to the terminal instead of sending them, so the form is testable
# without a mail account. In production, an unset SMTP_HOST makes the endpoint
# return an error rather than silently dropping a customer enquiry.
#
# These work with any standard mailbox (Loopia, one.com, Google Workspace,
# Microsoft 365, Fastmail, Postmark, Brevo, ...).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# Where enquiries are delivered, and the address they are sent from.
# CONTACT_FROM must be an address the SMTP account is allowed to send as,
# otherwise the mail will be rejected or land in spam.
CONTACT_TO="info@bellaservice.se"
CONTACT_FROM="webb@bellaservice.se"

# ---------------------------------------------------------------------------
# Contact form webhook (n8n)  — PLACEHOLDER, not yet connected
# ---------------------------------------------------------------------------
# Two independent ways to get an enquiry out of the form. Use either or both.
#
# 1. PUBLIC_CONTACT_WEBHOOK — the BROWSER posts the form straight here as JSON,
#    skipping this site's server entirely. This is the one that makes the form
#    work on GitHub Pages, which cannot run the SMTP endpoint.
#    It is public: the URL appears in the page source, so the n8n workflow must
#    do its own validation and rate limiting, and must return CORS headers
#    permitting the site's origin.
#
# 2. CONTACT_WEBHOOK — the SERVER mirrors each enquiry here after mailing it.
#    Private, never exposed to the browser, and failures are logged without
#    failing the visitor's submission. Use this on a Node host where SMTP is
#    the primary delivery and n8n is a copy for automation.
#
# Paste the Production URL from the n8n Webhook node.
PUBLIC_CONTACT_WEBHOOK=""
CONTACT_WEBHOOK=""
